# STC Colorado FSA State Committee app — environment variables template.
#
# Copy to .env for local dev:  cp .env.example .env
# .env is gitignored. Never commit real values.
#
# Production values live in the Render dashboard (Environment tab).
# Names are declared in render.yaml with sync: false — Render does not
# overwrite dashboard values on deploy.

# --- Server ---
# Port the Node server listens on. Render sets this automatically in prod;
# for local dev, default is 3000.
PORT=3000

# Bind address. 0.0.0.0 accepts external connections; 127.0.0.1 is localhost-only.
HOST=0.0.0.0

# --- Data persistence ---
# Directory for the SQLite database and uploaded files.
# Local dev: leave unset to use server/data/ (gitignored).
# Production: set to the mounted disk path (e.g. /var/data on Render).
# IMPORTANT: on Render, DATA_DIR MUST point inside the mounted disk
# (/var/data) or the SQLite DB will be wiped on every deploy.
# DATA_DIR=/var/data

# Optional overrides for individual paths. Defaults are derived from DATA_DIR:
#   SQLITE_PATH   = ${DATA_DIR}/pfa.db
#   UPLOADS_DIR   = ${DATA_DIR}/uploads
#   EXHIBITS_DIR  = ${DATA_DIR}/exhibits
# Override only if you need a path outside DATA_DIR. Any override on Render
# must also be inside /var/data to survive deploys.
# SQLITE_PATH=/var/data/pfa.db
# UPLOADS_DIR=/var/data/uploads
# EXHIBITS_DIR=/var/data/exhibits

# --- Microsoft Entra authentication (server-side token verification) ---
# From the Entra app registration in the MCCONNELL ENTERPRISES tenant.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Microsoft Entra authentication (client-side MSAL, baked at build time) ---
# Must be prefixed VITE_ to be exposed to the browser build.
# Values are identical to the server-side TENANT_ID / CLIENT_ID above.
# Redirect URI is NOT an env var — it is derived at runtime from
# window.location.origin and must be registered in the Azure App Registration:
#   https://stc-state-fsa.onrender.com
#   http://localhost:5173
#   http://localhost:3000
VITE_MICROSOFT_TENANT_ID=
VITE_MICROSOFT_CLIENT_ID=

# --- SharePoint document sync (via Microsoft Graph) ---
# Full URL of the SharePoint site. Example:
#   https://<tenant>.sharepoint.com/sites/<site-name>
SHAREPOINT_SITE_URL=

# Document library name. Default is "Shared Documents" if unset.
SHAREPOINT_LIBRARY=Shared Documents

# Folder inside the library that the Teams watcher polls.
# Default is "FSA - State Committee" if unset.
SHAREPOINT_WATCH_FOLDER=FSA - State Committee

# Root folder for member-shared docs surfaced in the Teams view.
# Default is "Committee Shared" if unset.
MEMBER_DOCS_ROOT=Committee Shared

# --- Summary page document URLs (client, baked at build time) ---
# Set in Render to make the session packet + exhibit links clickable on the
# Summary page. Leave unset locally if you don't need clickable links.
# Changing these in Render requires "Clear build cache & deploy" — a plain
# restart will not pick up new values.
VITE_ES_PACKET_URL=
VITE_RS_PACKET_URL=
VITE_EXHIBIT_1_URL=
VITE_EXHIBIT_2_URL=
VITE_EXHIBIT_5_URL=
